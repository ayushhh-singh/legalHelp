        "csmopRef": "9.2(iv), 9.2(vi)"
      },
      {
        "id": "enclosures",
        "label": {
          "en": "Enclosures mentioned in the text are listed",
          "hi": "पाठ में उल्लिखित संलग्नक सूचीबद्ध हैं"
        },
        "why": {
          "en": "A draft should clearly specify the enclosures which are to accompany the fair copy, and the number goes at the bottom left.",
          "hi": "मसौदे में स्पष्ट रूप से बताया जाना चाहिए कि स्वच्छ प्रति के साथ कौन-से संलग्नक जाएँगे, और संख्या नीचे बाईं ओर दी जाती है।"
        },
        "severity": "must",
        "rule": {
          "kind": "enclosuresConsistent"
        },
        "csmopRef": "9.2(vii)"
      },
      {
