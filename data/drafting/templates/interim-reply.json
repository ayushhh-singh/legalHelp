          "role": "body",
          "pattern": "(\\d{1,2}[.\\-/]\\d{1,2}[.\\-/]\\d{4}|[०-९]{1,2}[.\\-/][०-९]{1,2}[.\\-/][०-९]{4})"
        },
        "csmopRef": "8.9(ii)"
