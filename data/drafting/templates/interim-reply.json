    "checklist": [
      {
        "id": "subject",
        "label": {
          "en": "The subject is stated",
          "hi": "विषय लिखा गया है"
        },
        "why": {
          "en": "The specimens in Appendix 8.1 carry a subject line above the body on every form that is addressed to anyone.",
          "hi": "परिशिष्ट 8.1 के नमूनों में हर संबोधित प्रपत्र पर मुख्य भाग के ऊपर विषय पंक्ति होती है।"
        },
        "severity": "must",
        "rule": {
          "kind": "blockPresent",
          "role": "subject"
        },
        "csmopRef": "Appendix 8.1"
      },
      {
        "id": "number-and-date",
        "label": {
          "en": "Number and date are on the draft",
          "hi": "मसौदे पर संख्या और दिनांक हैं"
        },
        "why": {
          "en": "Every draft put up on a file bears the file number, and the number and date of the last communication in the series must be quoted.",
          "hi": "फाइल पर प्रस्तुत प्रत्येक मसौदे पर फाइल संख्या होती है, और शृंखला के अंतिम पत्र की संख्या तथा दिनांक उद्धृत की जानी चाहिए।"
        },
        "severity": "must",
        "rule": {
          "kind": "allRequired",
          "fields": [
            "fileNumber",
            "date"
          ]
        },
        "csmopRef": "9.2(iv), 9.2(vi)"
      },
      {
        "id": "third-person",
        "label": {
          "en": "Written in the third person",
          "hi": "अन्य पुरुष में लिखा गया"
        },
        "why": {
          "en": "An Office Memorandum is written in the third person and bears no salutation or subscription.",
          "hi": "कार्यालय ज्ञापन अन्य पुरुष में लिखा जाता है और उसमें कोई अभिवादन या मानार्थ संबोधन नहीं होता।"
        },
        "severity": "must",
        "rule": {
          "kind": "person",
          "value": "third"
        },
        "csmopRef": "8.4(3)"
      },
      {
        "id": "signature-block",
        "label": {
          "en": "Signature block carries designation, telephone and email",
          "hi": "हस्ताक्षर खंड में पदनाम, दूरभाष और ई-मेल हैं"
        },
        "why": {
          "en": "The name, designation, telephone number, fax number and e-mail address of the signing officer must invariably be on the draft.",
          "hi": "हस्ताक्षर करने वाले अधिकारी का नाम, पदनाम, दूरभाष संख्या, फैक्स संख्या और ई-मेल पता मसौदे पर अनिवार्यतः होना चाहिए।"
        },
        "severity": "must",
        "rule": {
          "kind": "allRequired",
          "fields": [
            "signatoryName",
            "signatoryDesignation",
            "phone",
            "email"
          ]
        },
        "csmopRef": "9.2(xii)"
      },
      {
        "id": "final-reply-date",
        "label": {
          "en": "The date of the final reply is named",
          "hi": "अंतिम उत्तर की तारीख दी गई है"
        },
        "why": {
          "en": "An interim reply exists to give the party a date. Without one it says only that nothing has happened, which the party already knows.",
          "hi": "अंतरिम उत्तर इसलिए है कि पक्षकार को एक तारीख मिले। तारीख के बिना वह केवल यह कहता है कि कुछ नहीं हुआ, जो पक्षकार पहले से जानता है।"
        },
        "severity": "must",
        "rule": {
