# Cloudflare Pages response headers.
#
# Read this alongside tests/e2e/csp.spec.ts — that spec parses THIS file,
# replays every header onto the document response in a real browser, and
# fails on any console error or securitypolicyviolation event. There is no
# second copy of the policy in a <meta> tag: this file is the only source.
#
# See docs/DECISIONS.md ADR-030 for three things this policy decides, and
# ADR-037 for what Tier 0 and Tier 2 changed about the first of them:
#   * connect-src now names the AI layer's opt-in destinations. This is NOT
#     the privacy control — the consent gate is, and with AI off the app makes
#     no request to any of them. CSP is the backstop, and a backstop that
#     refuses the feature the app ships is a broken app rather than a private
#     one (docs/DATA-GAPS.md #57 and #61 were exactly that);
#   * script-src carries 'wasm-unsafe-eval' because Tier 0 compiles the
#     model's WebAssembly runtime. It does NOT carry 'unsafe-eval': WASM
#     compilation and string evaluation are separate capabilities, and only
#     the first one is wanted here;
#   * style-src carries 'unsafe-inline' because Radix Dialog's scroll lock
#     injects a <style> element whose content varies with the scrollbar
#     width, so no hash can cover it — but style-src-attr is 'none', which
#     keeps every inline style= ATTRIBUTE blocked. React writes styles
#     through CSSOM, so nothing in the app needs the attribute form;
#   * script-src has no 'unsafe-eval': zod probes for it in a try/catch at
#     import time and falls back to its interpreted validator, so the one
#     violation the browser reports is a capability check that already
#     handled being refused (tests/e2e/csp.spec.ts allowlists exactly it).

# The connect-src destinations, and who reaches each:
#   api.anthropic.com  — Tier 1 (the reader's own key) and nothing else.
#   huggingface.co and its LFS CDNs (*.hf.co, *.huggingface.co) — Tier 0's
#     one-time model download, started by hand in Settings. The CDN hostname
#     the redirect lands on is not fixed and is not published, which is why
#     these two are wildcard subdomains rather than a list; docs/DATA-GAPS.md
#     #69 has what that costs and what would tighten it.
#   raw.githubusercontent.com — Tier 0's compiled model library (.wasm), which
#     mlc-ai publishes from a GitHub repository rather than from Hugging Face.
# Tier 3's named hosts, and the one thing this policy cannot do:
#   generativelanguage.googleapis.com, api.groq.com and openrouter.ai — the
#     three free services the consent notice names by name. They are listed
#     because the app RECOMMENDS them; a reader who takes the recommendation
#     should not then have to widen a policy they cannot edit.
#   http://localhost:* and http://127.0.0.1:* — Ollama, running on the reader's
#     own machine. Explicitly `http:`, because that is what Ollama serves and
#     refusing it would rule out the one option on Tier 3 that sends nothing
#     over a network at all. It reaches only the reader's own loopback.
# ANY OTHER Tier 3 ENDPOINT IS REFUSED BY THIS POLICY on the hosted site, and
# that is a real limit rather than an oversight: `connect-src` cannot be widened
# at runtime for a URL the reader types, and widening it to `https:` would throw
# away the backstop for every other tier at the same time. An operator
# self-hosting this app can add their own host to the line below;
# docs/DATA-GAPS.md #75 records what that costs and the two alternatives.
#
# Tier 2's own origin is NOT here: it is only known at build time, so
# vite.config.ts appends VITE_AI_PROXY_URL's origin to this directive when a
# build sets one. A build without one emits this line unchanged, which is what
# tests/e2e/csp.spec.ts reads.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; style-src-attr 'none'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.anthropic.com https://huggingface.co https://*.huggingface.co https://*.hf.co https://raw.githubusercontent.com https://generativelanguage.googleapis.com https://api.groq.com https://openrouter.ai http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; manifest-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

# The service worker must never be served from a stale edge cache, or a
# reader stays on an old shell after a deploy. vite-plugin-pwa fingerprints
# every other asset, so only this one file needs the exemption.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Fingerprinted by Vite — the filename changes when the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
