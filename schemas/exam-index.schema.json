{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/exam-index.schema.json",
  "title": "The exam-profile picker's index",
  "description": "Enough to draw the profile picker and nothing else: a name, the organisation, the type, the paper count and the total marks. A profile itself is 6-12 KB and is fetched only once one has been chosen — the same arrangement `data/drafting/index.json` and `data/library/index.json` already have, for the same reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "disclaimer", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "organisation",
          "examType",
          "file",
          "paperCount",
          "totalMarks",
          "mappedUnits",
          "externalUnits",
          "verify"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "$ref": "#/$defs/bilingual" },
          "organisation": { "$ref": "#/$defs/bilingual" },
          "examType": { "enum": ["ldce", "departmental-promotion", "confirmation", "other"] },
          "file": { "type": "string", "pattern": "^profiles/[a-z0-9-]+\\.json$" },
          "paperCount": { "type": "integer", "minimum": 1 },
          "totalMarks": { "type": "integer", "minimum": 1 },
          "mappedUnits": {
            "description": "Syllabus units this app can actually teach. Shown on the card beside `externalUnits`, so a reader sees the honest ratio before they choose a profile rather than after.",
            "type": "integer",
            "minimum": 0
          },
          "externalUnits": { "type": "integer", "minimum": 0 },
          "verify": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "hi"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    }
  }
}
