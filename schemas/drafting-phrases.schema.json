{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/drafting-phrases.schema.json",
  "title": "Bilingual phrase library for drafting",
  "description": "Opening, transition and closing phrases, tagged by the templates they belong in. Each phrase is a matched pair, not a translation: the Hindi is the sentence a Hindi draft of the same document actually uses. `appliesTo` is a list of template ids or the single entry \"*\".",
  "type": "object",
  "required": ["version", "generatedAt", "disclaimer", "phrases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "phrases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/phrase" } }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "hi"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "reference": { "type": "string" },
        "dated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "$ref": "#/$defs/bilingual" }
      }
    },
    "phrase": {
      "type": "object",
      "required": ["id", "kind", "appliesTo", "text", "source", "fetchedAt", "verify"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": {
          "type": "string",
          "enum": ["opening", "transition", "closing", "noting", "endorsement", "courtesy"]
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^([a-z0-9-]+|\\*)$" }
        },
        "text": { "$ref": "#/$defs/bilingual" },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "note": { "$ref": "#/$defs/bilingual" },
        "csmopRef": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "fetchedAt": { "type": "string" },
        "verify": { "type": "boolean" }
      }
    }
  }
}
