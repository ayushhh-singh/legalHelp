{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/rules-cards.schema.json",
  "title": "Trainer cards for one Act, rule book or manual",
  "description": "Every card the Rules Trainer can schedule, plus every card that was generated or authored and then rejected. Rejects stay in the file as an audit trail and are never served: `reviewState` decides, and only \"approved\" is served. A served card must carry Hindi on every string a reader sees — that is asserted in tests/rules-data.test.ts, not merely intended.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "act", "disclaimer", "source", "cards"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short", "unit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/bilingual" },
        "short": { "$ref": "#/$defs/bilingual" },
        "unit": { "$ref": "#/$defs/bilingual" }
      }
    },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "source": { "$ref": "#/$defs/source" },
    "cards": { "type": "array", "items": { "$ref": "#/$defs/card" } }
  },
  "$defs": {
    "bilingual": {
      "description": "Both languages present and non-empty. Used wherever a card is served.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "hi"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "bilingualDraft": {
      "description": "`hi` may be empty, and then the card's reviewState must be \"needs-hindi\" — a rule extracted from an English-only issue has no Hindi until someone writes it. The pairing is enforced in tests, because a schema cannot see across two fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "hi"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "ruleRef": {
      "description": "Resolves into data/rules/text/<act>.json. `textId` is a rule record's `id`; a card whose ruleRef does not resolve fails the data tests.",
      "type": "object",
      "additionalProperties": false,
      "required": ["textId", "citation"],
      "properties": {
        "textId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "citation": { "$ref": "#/$defs/bilingual" }
      }
    },
    "generationMeta": {
      "description": "The four-stage authoring record. Present on every authored question and absent from every generated card, so an audit can tell at a glance which is which.",
      "type": "object",
      "additionalProperties": false,
      "required": ["promptVersion", "batchId", "stageA", "critic", "dedup", "groundingRuleIds"],
      "properties": {
        "promptVersion": { "type": "string", "minLength": 1 },
        "batchId": { "type": "string", "minLength": 1 },
        "stageA": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "angle"],
          "properties": {
            "index": { "type": "integer", "minimum": 1 },
            "angle": {
              "description": "What the question is testing, so a batch can be checked for spread rather than fifteen questions about the same sub-rule.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "critic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "reason"],
          "properties": {
            "verdict": { "enum": ["approve", "reject"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "blindVerify": {
          "description": "Stage C, MCQ and true/false only. `answered` is the option index chosen without looking at the stored key; a mismatch auto-rejects.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["answered", "matched"],
          "properties": {
            "answered": { "type": "integer", "minimum": 0 },
            "matched": { "type": "boolean" },
            "note": { "type": "string" }
          }
        },
        "dedup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxScore", "verdict"],
          "properties": {
            "maxScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "against": { "type": ["string", "null"] },
            "verdict": { "enum": ["keep", "duplicate"] }
          }
        },
        "groundingRuleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "act",
        "rule",
        "kind",
        "front",
        "back",
        "ruleRef",
        "difficulty",
        "reviewed",
        "reviewState",
        "version",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "act": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "rule": { "type": "string", "minLength": 1 },
        "subRule": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["rule", "cloze", "mcq", "trueFalse", "scenario", "fillRuleNo"] },
        "front": { "$ref": "#/$defs/bilingualDraft" },
        "back": { "$ref": "#/$defs/bilingualDraft" },
        "cloze": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "answer"],
          "properties": {
            "text": {
              "description": "The excerpt with the answer replaced by the blank marker \"____\".",
              "$ref": "#/$defs/bilingualDraft"
            },
            "answer": { "$ref": "#/$defs/bilingualDraft" }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/bilingualDraft" }
        },
        "answerIndex": { "type": "integer", "minimum": 0 },
        "explanation": { "$ref": "#/$defs/bilingualDraft" },
        "ruleRef": { "$ref": "#/$defs/ruleRef" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "reviewed": { "type": "boolean" },
        "reviewState": {
          "description": "\"approved\" is the only served state. \"needs-hindi\" is a card whose English is right and whose Hindi has not been written yet; \"rejected\" keeps a bad card visible to an auditor without ever showing it to a reader.",
          "enum": ["unreviewed", "approved", "rejected", "needs-hindi"]
        },
        "reviewNote": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "verify": { "type": "boolean" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "source": { "$ref": "#/$defs/source" },
        "generationMeta": { "$ref": "#/$defs/generationMeta" }
      }
    }
  }
}
