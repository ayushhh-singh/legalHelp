{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/portals.schema.json",
  "title": "Portals and helplines directory",
  "description": "One record per Government of India portal or helpline an officer routinely needs — e-HRMS, SPARROW, CGHS, Bhavishya, CPGRAMS and the rest. This is a directory of public URLs, not a login vault: nothing here collects credentials, and `helpline` is a published public number or null, never a personal contact.",
  "type": "object",
  "required": ["version", "generatedAt", "disclaimer", "portals"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "portals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/portal" }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "hi"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "reference": { "type": "string" },
        "dated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "$ref": "#/$defs/bilingual" }
      }
    },
    "portal": {
      "type": "object",
      "required": ["id", "name", "shortName", "purpose", "url", "category", "helpline", "administeredBy", "verify"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/bilingual" },
        "shortName": { "$ref": "#/$defs/bilingual" },
        "purpose": { "$ref": "#/$defs/bilingual" },
        "url": { "type": "string", "pattern": "^https?://" },
        "category": {
          "enum": [
            "hr-service",
            "pay-pension",
            "health",
            "grievance",
            "training",
            "provident-fund-nps",
            "e-office",
            "procurement",
            "rajbhasha",
            "law-gazette",
            "welfare"
          ]
        },
        "helpline": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["label"],
              "additionalProperties": false,
              "properties": {
                "phone": { "type": "string" },
                "email": { "type": "string" },
                "label": { "$ref": "#/$defs/bilingual" }
              }
            }
          ]
        },
        "administeredBy": { "$ref": "#/$defs/bilingual" },
        "source": { "$ref": "#/$defs/source" },
        "verify": { "type": "boolean" }
      }
    }
  }
}
