{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/holidays.schema.json",
  "title": "One year's Central Government holiday calendar",
  "description": "The gazetted (compulsory) and restricted holiday lists a DoPT circular publishes for Delhi/New Delhi offices each year, from the annual 'Holidays to be observed in Central Government Offices' O.M. State-wise and department-wise restricted-holiday lists vary from this one — `delegationNote` says so, and the UI must show it rather than imply this list is universal.",
  "type": "object",
  "required": [
    "version",
    "generatedAt",
    "disclaimer",
    "year",
    "source",
    "fetchedAt",
    "verify",
    "delegationNote",
    "gazetted",
    "restricted"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "source": { "$ref": "#/$defs/source" },
    "fetchedAt": { "type": "string" },
    "verify": { "type": "boolean" },
    "delegationNote": { "$ref": "#/$defs/bilingual" },
    "gazetted": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/holiday" }
    },
    "restricted": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/holiday" }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "hi"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "reference": { "type": "string" },
        "dated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "$ref": "#/$defs/bilingual" }
      }
    },
    "holiday": {
      "type": "object",
      "required": ["id", "name", "date", "day"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/bilingual" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "day": {
          "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
        }
      }
    }
  }
}
