{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/drafting-index.schema.json",
  "title": "Index of the drafting templates",
  "description": "What the Drafting Studio can load without loading anything. One entry per file under data/drafting/templates, in display order, so a picker can be rendered on the first frame and the template itself fetched only once a document type has been chosen.",
  "type": "object",
  "required": ["version", "generatedAt", "disclaimer", "templates"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string"
    },
    "disclaimer": {
      "$ref": "#/$defs/bilingual"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "shortName", "useWhen", "group", "person", "csmopParas"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "$ref": "#/$defs/bilingual"
          },
          "shortName": {
            "$ref": "#/$defs/bilingual"
          },
          "useWhen": {
            "$ref": "#/$defs/bilingual",
            "description": "One line, shown on the picker card: when this form is the right one."
          },
          "group": {
            "type": "string",
            "enum": ["communication", "internal", "personal", "statutory"]
          },
          "person": {
            "type": "string",
            "enum": ["first", "third"]
          },
          "csmopParas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "verify": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "hi"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "hi": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
