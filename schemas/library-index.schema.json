{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/library-index.schema.json",
  "title": "The Library's shelf",
  "description": "What /library needs to draw one card per work — names, counts and citations, with no table of contents and no reading order. The fifteen work files together are far larger than this, and a reader looking at a shelf has not chosen a book yet. Same arrangement data/drafting/index.json has (ADR-020).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "disclaimer", "totals", "works"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["works", "units", "minutes"],
      "properties": {
        "works": { "type": "integer", "minimum": 1 },
        "units": { "type": "integer", "minimum": 1 },
        "minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "works": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "shortTitle",
          "category",
          "description",
          "unitLabel",
          "publisher",
          "corpus",
          "tocSource",
          "unitCount",
          "estimatedMinutes",
          "examTags",
          "officialUrl",
          "source",
          "file"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "$ref": "#/$defs/bilingual" },
          "shortTitle": { "$ref": "#/$defs/bilingual" },
          "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
          "category": {
            "type": "string",
            "enum": [
              "criminal-law",
              "service-rules",
              "office-procedure",
              "transparency",
              "official-language",
              "security",
              "workplace",
              "finance",
              "other"
            ]
          },
          "description": { "$ref": "#/$defs/bilingual" },
          "unitLabel": { "$ref": "#/$defs/bilingual" },
          "publisher": { "type": "string", "minLength": 1 },
          "corpus": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "file"],
            "properties": {
              "kind": { "type": "string", "enum": ["rules", "law"] },
              "file": { "type": "string", "pattern": "^(rules/text|law)/[a-z0-9-]+\\.json$" }
            }
          },
          "tocSource": { "type": "string", "enum": ["chapters", "numbering", "flat"] },
          "unitCount": { "type": "integer", "minimum": 1 },
          "estimatedMinutes": { "type": "integer", "minimum": 1 },
          "examTags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "officialUrl": { "type": "string", "pattern": "^https?://" },
          "source": { "$ref": "#/$defs/source" },
          "file": { "type": "string", "pattern": "^works/[a-z0-9-]+\\.json$" },
          "verify": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "hi"],
      "properties": { "en": { "type": "string" }, "hi": { "type": "string" } }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    }
  }
}
