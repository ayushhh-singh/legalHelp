{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/drafting-terms.schema.json",
  "title": "Rajbhasha structural terms",
  "description": "The standard Hindi equivalent of every structural element of a Central Secretariat document — the names of the forms themselves, the parts of a document, the urgency labels and the designations that sign one. `hi` is what the Hindi CSMOP 2022 prints where it prints it; where it does not, the term carries verify: true and cites the Department of Official Language glossary instead.",
  "type": "object",
  "required": ["version", "generatedAt", "disclaimer", "terms"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "terms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/term" } }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "hi"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "reference": { "type": "string" },
        "dated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "$ref": "#/$defs/bilingual" }
      }
    },
    "term": {
      "type": "object",
      "required": ["id", "category", "en", "hi", "source", "fetchedAt", "verify"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": {
          "type": "string",
          "enum": ["form", "part", "urgency", "designation", "process", "phraseElement"]
        },
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 },
        "alsoHi": {
          "type": "array",
          "description": "Other Hindi renderings in current official use. The first entry of `hi` is what CSMOP 2022 prints; these are what an officer may also see.",
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "$ref": "#/$defs/bilingual" },
        "csmopRef": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "fetchedAt": { "type": "string" },
        "verify": { "type": "boolean" }
      }
    }
  }
}
