{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/rules-text.schema.json",
  "title": "Rule text for one Act, rule book or manual",
  "description": "One record per rule or section, as published. This is what the Rules Trainer's cards cite and what the Law Converter and Drafting Studio link to. Hindi is empty throughout and `hindiTextExtractable` says why: every Ministry Hindi issue fetched is typeset from a legacy font whose text layer is byte soup that looks like Devanagari.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "act",
    "hindiTextExtractable",
    "hindiNote",
    "disclaimer",
    "source",
    "rules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short", "unit", "publisher"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/bilingual" },
        "short": { "$ref": "#/$defs/bilingual" },
        "unit": {
          "$ref": "#/$defs/bilingual",
          "description": "What one record is called in this document — Rule, Section or Paragraph."
        },
        "publisher": { "type": "string", "minLength": 1 }
      }
    },
    "hindiTextExtractable": {
      "type": "boolean",
      "description": "False everywhere so far. When a Ministry publishes a Hindi issue with a real text layer this becomes true and `text.hi` may be filled from it."
    },
    "hindiNote": { "$ref": "#/$defs/bilingual" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "source": { "$ref": "#/$defs/source" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "hi"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "bilingualText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "hi"],
      "properties": {
        "en": { "type": "string" },
        "hi": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "heading", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "number": {
          "type": "string",
          "minLength": 1,
          "description": "As the document prints it: \"11\", \"11A\", \"5.2\"."
        },
        "heading": { "$ref": "#/$defs/bilingualText" },
        "text": { "$ref": "#/$defs/bilingualText" },
        "subRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "text"],
            "properties": {
              "number": { "type": "string", "minLength": 1 },
              "text": { "$ref": "#/$defs/bilingualText" }
            }
          }
        }
      }
    }
  }
}
