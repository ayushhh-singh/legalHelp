{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/rules-index.schema.json",
  "title": "Index of the rules datasets",
  "description": "What the Rules Trainer loads first: the acts, their bilingual names, how many rules and cards each has by kind, and where the text and card files are. Small enough that the picker downloads nothing else — the same arrangement data/drafting/index.json has (ADR-020).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "disclaimer", "totals", "acts"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "totals": { "$ref": "#/$defs/counts" },
    "acts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/act" } }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "hi"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "cards", "served", "byKind"],
      "properties": {
        "rules": { "type": "integer", "minimum": 0 },
        "subRules": { "type": "integer", "minimum": 0 },
        "cards": {
          "description": "Every card in the file, served or not.",
          "type": "integer",
          "minimum": 0
        },
        "served": {
          "description": "Cards with reviewState \"approved\". Only these are scheduled.",
          "type": "integer",
          "minimum": 0
        },
        "needsHindi": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "byKind": {
          "description": "Served counts per kind. A kind with none is omitted.",
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "propertyNames": { "enum": ["rule", "cloze", "mcq", "trueFalse", "scenario", "fillRuleNo"] }
        }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short", "unit", "publisher", "text", "cards", "counts", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "$ref": "#/$defs/bilingual" },
        "short": { "$ref": "#/$defs/bilingual" },
        "unit": { "$ref": "#/$defs/bilingual" },
        "publisher": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "pattern": "^text/[a-z0-9-]+\\.json$" },
        "cards": { "type": "string", "pattern": "^cards/[a-z0-9-]+\\.json$" },
        "counts": { "$ref": "#/$defs/counts" },
        "hindiTextExtractable": { "type": "boolean" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https?://" }
          }
        }
      }
    }
  }
}
