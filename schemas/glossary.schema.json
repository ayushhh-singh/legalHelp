{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/glossary.schema.json",
  "title": "Hindi administrative glossary",
  "description": "The general Rajbhasha administrative vocabulary an officer meets outside a specific document's own structure — designations, office procedure, file handling, finance/accounts, establishment and leave, administrative law, and information technology. `data/drafting/structure-terms.json` is the sibling dataset for the parts of a CSMOP document itself (forms, blocks, urgency grading); this dataset does not repeat those terms. Every entry here is compiled from general Rajbhasha usage rather than read off one page of one fetched document, so every entry carries verify: true.",
  "type": "object",
  "required": ["version", "generatedAt", "disclaimer", "terms"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "terms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/term" } }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "hi"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "reference": { "type": "string" },
        "dated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "$ref": "#/$defs/bilingual" }
      }
    },
    "term": {
      "type": "object",
      "required": ["id", "category", "en", "hi", "source", "fetchedAt", "verify"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": {
          "type": "string",
          "enum": ["designation", "office", "file", "finance", "establishment", "legal", "it"]
        },
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 },
        "alsoHi": {
          "type": "array",
          "description": "Other Hindi renderings in current official use, beyond the standard one in `hi`.",
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "$ref": "#/$defs/bilingual" },
        "source": { "$ref": "#/$defs/source" },
        "fetchedAt": { "type": "string" },
        "verify": { "type": "boolean" }
      }
    }
  }
}
