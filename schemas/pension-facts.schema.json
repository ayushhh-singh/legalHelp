{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/pension-facts.schema.json",
  "title": "Retirement and pension facts not already in a pay scheme file",
  "description": "Superannuation, gratuity, commutation and the General Provident Fund interest rate — the facts the retirement calculator needs that are not NPS or UPS (those are data/pay/nps.json and data/pay/ups.json, which this dataset does not repeat). Every block carries its own source and verify flag because each rests on a different order.",
  "type": "object",
  "required": ["version", "generatedAt", "disclaimer", "superannuation", "gratuity", "commutation", "gpf"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "superannuation": {
      "type": "object",
      "required": ["ageYears", "rule", "source", "verify"],
      "additionalProperties": false,
      "properties": {
        "ageYears": { "const": 60 },
        "rule": { "$ref": "#/$defs/bilingual" },
        "source": { "$ref": "#/$defs/source" },
        "verify": { "type": "boolean" }
      }
    },
    "gratuity": {
      "type": "object",
      "required": [
        "fractionPerSixMonths",
        "maxMultiplier",
        "baseCeiling",
        "daLinked",
        "deathGratuityTable",
        "rule",
        "source",
        "verify"
      ],
      "additionalProperties": false,
      "properties": {
        "fractionPerSixMonths": { "type": "number" },
        "maxMultiplier": { "type": "number" },
        "baseCeiling": { "type": "number" },
        "daLinked": {
          "type": "object",
          "required": ["kind", "timesApplied"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["quarter-per-fifty", "not-applicable"] },
            "timesApplied": { "type": "integer", "minimum": 0 },
            "note": { "$ref": "#/$defs/bilingual" }
          }
        },
        "deathGratuityTable": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["minYears", "maxYears", "multiplier", "label"],
            "additionalProperties": false,
            "properties": {
              "minYears": { "type": "number" },
              "maxYears": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
              "multiplier": {
                "oneOf": [{ "type": "number" }, { "const": "half-per-six-months-max-33" }]
              },
              "label": { "$ref": "#/$defs/bilingual" }
            }
          }
        },
        "rule": { "$ref": "#/$defs/bilingual" },
        "source": { "$ref": "#/$defs/source" },
        "verify": { "type": "boolean" }
      }
    },
    "commutation": {
      "type": "object",
      "required": ["maxFraction", "rule", "table", "source", "verify"],
      "additionalProperties": false,
      "properties": {
        "maxFraction": { "const": 0.4 },
        "rule": { "$ref": "#/$defs/bilingual" },
        "table": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": ["ageNextBirthday", "factor"],
            "additionalProperties": false,
            "properties": {
              "ageNextBirthday": { "type": "integer", "minimum": 17, "maximum": 100 },
              "factor": { "type": "number", "minimum": 0 }
            }
          }
        },
        "source": { "$ref": "#/$defs/source" },
        "verify": { "type": "boolean" }
      }
    },
    "gpf": {
      "type": "object",
      "required": ["rateHistory", "source", "verify"],
      "additionalProperties": false,
      "properties": {
        "rateHistory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["effectiveFrom", "rate"],
            "additionalProperties": false,
            "properties": {
              "effectiveFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "rate": { "type": "number", "minimum": 0, "maximum": 20 }
            }
          }
        },
        "source": { "$ref": "#/$defs/source" },
        "verify": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "hi"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "reference": { "type": "string" },
        "dated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "$ref": "#/$defs/bilingual" }
      }
    }
  }
}
