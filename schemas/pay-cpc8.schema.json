{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahayak.local/schemas/pay-cpc8.schema.json",
  "title": "Eighth Central Pay Commission — status",
  "description": "Status facts only. There is no 8th CPC pay matrix, no notified fitment factor and no notified date of effect, so this dataset carries none. `fitmentFactorsDiscussed` records figures that have been floated in public discussion, each with the source that floated it and `status: projected` — the UI must never show one of these as a rate.",
  "type": "object",
  "required": [
    "version",
    "generatedAt",
    "disclaimer",
    "status",
    "commission",
    "termsOfReference",
    "fitmentFactorsDiscussed",
    "whatIsNotKnown"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string" },
    "disclaimer": { "$ref": "#/$defs/bilingual" },
    "status": { "const": "constituted" },
    "commission": {
      "type": "object",
      "required": [
        "name",
        "constitutedOn",
        "resolutionNumber",
        "members",
        "headquarters",
        "reportDue",
        "source",
        "fetchedAt",
        "verify"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/bilingual" },
        "constitutedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "resolutionNumber": { "type": "string", "minLength": 1 },
        "members": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["role", "name"],
            "additionalProperties": false,
            "properties": {
              "role": { "$ref": "#/$defs/bilingual" },
              "name": { "$ref": "#/$defs/bilingual" }
            }
          }
        },
        "headquarters": { "$ref": "#/$defs/bilingual" },
        "reportDue": {
          "type": "object",
          "required": ["withinMonths", "notBefore", "note"],
          "additionalProperties": false,
          "properties": {
            "withinMonths": { "type": "integer", "minimum": 1 },
            "notBefore": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "note": { "$ref": "#/$defs/bilingual" }
          }
        },
        "source": { "$ref": "#/$defs/source" },
        "fetchedAt": { "type": "string" },
        "verify": { "type": "boolean" }
      }
    },
    "termsOfReference": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "text"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "text": { "$ref": "#/$defs/bilingual" }
        }
      }
    },
    "fitmentFactorsDiscussed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["value", "status", "attributedTo", "source", "fetchedAt", "verify"],
        "additionalProperties": false,
        "properties": {
          "value": { "type": "number", "minimum": 1, "maximum": 5 },
          "status": { "const": "projected" },
          "attributedTo": { "$ref": "#/$defs/bilingual" },
          "note": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bilingual" }] },
          "source": { "$ref": "#/$defs/source" },
          "fetchedAt": { "type": "string" },
          "verify": { "type": "boolean" }
        }
      }
    },
    "whatIsNotKnown": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bilingual" }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "required": ["en", "hi"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hi": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "reference": { "type": "string" },
        "dated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "$ref": "#/$defs/bilingual" }
      }
    }
  }
}
