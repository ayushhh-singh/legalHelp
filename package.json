{
  "name": "sahayak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sahayak \u2014 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u0939\u093e\u092f\u0915. Offline-first bilingual reference and productivity PWA for Indian central government officers.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-native/bin/tsc -p tsconfig.json --noEmit && node node_modules/typescript-native/bin/tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "fonts:licenses": "node scripts/collect-font-licenses.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "i18next": "26.4.0",
