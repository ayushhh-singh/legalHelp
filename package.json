{
  "name": "sahayak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sahayak — सरकारी सहायक. Offline-first bilingual reference and productivity PWA for Indian central government officers.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm test"
  },
  "dependencies": {
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.5",
    "dexie-react-hooks": "1.1.7",
    "i18next": "23.16.8",
    "lucide-react": "0.499.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "6.30.6",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/react": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.10.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "6.2.5",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.6.14",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.6.3",
    "typescript-eslint": "8.68.0",
    "vite": "5.4.21",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "2.1.9",
    "workbox-window": "7.4.1"
  }
}
