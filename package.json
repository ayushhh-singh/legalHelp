  "pnpm": {
    "peerDependencyRules": {
      "_comment": "eslint-plugin-jsx-a11y 6.10.2 declares eslint <=9 but runs correctly on 10 \u2014 verified with a deliberate jsx-a11y/alt-text violation. See ADR-009.",
